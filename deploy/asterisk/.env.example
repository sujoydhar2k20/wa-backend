# Copy to .env (chmod 600) and fill in. Never commit .env.
SIP_DOMAIN=lk.biswakarmagold.com
PUBLIC_IP=94.136.190.186
# Business number, digits only with country code (no +)
WA_BUSINESS_NUMBER=919874085669
# From: node scripts/calling-sip-setup.js password
META_SIP_PASSWORD=CHANGE_ME
# Softphone passwords for test extensions (openssl rand -hex 16)
EXT_1001_PASSWORD=CHANGE_ME
EXT_1002_PASSWORD=CHANGE_ME
EXT_1003_PASSWORD=CHANGE_ME
# Media port range (must match the ufw rule)
RTP_START=10000
RTP_END=10999
# Ring rule: assigned staff (1001) first, then everyone (1001-1003)
RING_FIRST_SECONDS=25
RING_ALL_SECONDS=25
# no = customer hears ringing until staff answer (Meta's 30-60 s answer limit applies)
# yes = answer immediately and play ringback while staff are rung (test only)
EARLY_ANSWER=no
RECORD_CALLS=yes
