# Copy to .env (chmod 600) and fill in. Never commit .env.
SIP_DOMAIN=lk.biswakarmagold.com
PUBLIC_IP=94.136.190.186
# Business number, digits only with country code (no +)
WA_BUSINESS_NUMBER=919874085669
# Filled by: node scripts/calling-sip-setup.js password|rotate-sip-password ...
META_SIP_PASSWORD=
# Node backend on this server (the port pm2 runs it on)
BACKEND_URL=http://127.0.0.1:3000
# Same value as CALLING_INTERNAL_SECRET in the backend .env   (openssl rand -hex 32)
CALLING_INTERNAL_SECRET=CHANGE_ME
# Same value as ASTERISK_AMI_SECRET in the backend .env      (openssl rand -hex 32)
AMI_SECRET=CHANGE_ME
# Media port range (must match the ufw rule)
RTP_START=10000
RTP_END=10999
# Seconds to wait for a device to come online (e.g. phone woken by push) before ringing a stage
DEVICE_WAIT_SECONDS=8
RECORD_CALLS=yes
